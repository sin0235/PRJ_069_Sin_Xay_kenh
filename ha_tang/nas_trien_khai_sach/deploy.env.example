# Copy to deploy.env, set mode 0600, and replace every placeholder.
PRJ069_COMPOSE_PROJECT_NAME=prj069-nas
PRJ069_BACKEND_IMAGE=prj069-nas-backend:release
PRJ069_WEB_IMAGE=prj069-nas-web:release
PRJ069_GATEWAY_IMAGE=prj069-nas-gateway:release
PRJ069_DATA_VOLUME=prj069-nas-data
PRJ069_PROFILE_VOLUME=prj069-nas-flow-profiles
PRJ069_MODEL_VOLUME=prj069-nas-models
PRJ069_BOOTSTRAP_MODE=adopt

WEB_BIND=127.0.0.1
WEB_PORT=3069
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=https://studio.example.invalid

AUTH_OWNER_EMAIL=replace-with-owner-email
AUTH_OWNER_PASSWORD_SECRET_FILE=./secrets/owner-password
SIN_WORKSPACE_ID=replace-with-configured-uuid
SIN_WORKSPACE_NAME=replace-with-workspace-name
BAHA_AUTH_JWT_SECRET=replace-with-random-secret-at-least-32-bytes
BAHA_AUTH_JWT_ISSUER=replace-with-issuer
BAHA_AUTH_JWT_AUDIENCE=replace-with-audience
LLM_ENCRYPTION_MASTER_KEY=replace-with-a-different-random-secret-at-least-32-bytes
