# Bien moi truong mau cho SIN Content Intelligence API (Che do Offline)
APP_ENV=offline
DEBUG=true
DATABASE_URL=sqlite:///./sin_content_offline.db
JWT_SECRET_KEY=sin-dev-secret-do-not-use-in-production
DEFAULT_MAX_COST_USD_PER_RUN=5.0
SYNTHETIC_DATA_ALLOWED=true

# Thư mục cache riêng cho VieNeu CPU
PRJ069_VIENU_HF_HOME=

# Cau hinh LLM 9Router Gateway (Tuy chon)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_INPUT_BYTES=20000
LLM_MAX_OUTPUT_TOKENS=1500
LLM_INPUT_USD_PER_1K_TOKENS=0.0
LLM_OUTPUT_USD_PER_1K_TOKENS=0.0
LLM_BUDGET_UNITS_PER_USD=1.0

